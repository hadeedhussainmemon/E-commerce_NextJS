# Database Connection (MongoDB Atlas)
MONGODB_URI=
# API Configuration
# Local: http://localhost:3000
# Production: https://your-project.vercel.app
NEXT_PUBLIC_API_BASE_URL=

# Admin Authentication
# Generate a random long string for security (e.g. using `openssl rand -base64 32`)
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Store Settings
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: External Image Hosting (if using Cloudinary)
# Leave empty if using local/base64 images
NEXT_PUBLIC_IMAGE_BASE_URL=